                            builder: (_) => SitePage(
                              token: widget.token,
                              user: widget.user,
                              companyName: selectedCompany!,
                            ),
                          ),
                        );
                      },
                child: const Text('CONTINUE'),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

