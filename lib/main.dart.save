// ============================================================
// DASHBOARD
// ============================================================

class DashboardPage extends StatefulWidget {
  final String token;
  final Map<String, dynamic> user;
  final String companyName;
  final String siteName;

  const DashboardPage({
    super.key,
    required this.token,
    required this.user,
    required this.companyName,
    required this.siteName,
  });

  @override
  State<DashboardPage> createState() => _DashboardPageState();
}

class _DashboardPageState extends State<DashboardPage> {
  int selectedIndex = 0;

  @override
  Widget build(BuildContext context) {
    final pages = [
      DailyMeteringPage(
        siteName: widget.siteName,
      ),
      InverterReadingsPage(
        siteName: widget.siteName,
      ),
    ];

    return Scaffold(
      appBar: AppBar(
        title: Text(widget.siteName),
      ),

      drawer: Drawer(
        child: ListView(
          padding: EdgeInsets.zero,
          children: [
            DrawerHeader(
              decoration: const BoxDecoration(
                color: Color(0xFF1565C0),
              ),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Icon(
                    Icons.electric_meter,
                    color: Colors.white,
                    size: 45,
                  ),

                  const SizedBox(height: 8),

                  const Text(
                    'Metering ZW',
                    style: TextStyle(
                      color: Colors.white,
                      fontSize: 20,
                      fontWeight: FontWeight.bold,
                    ),
                  ),

                  const SizedBox(height: 5),

                  Text(
                    widget.siteName,
                    style: const TextStyle(
                      color: Colors.white70,
                    ),
                  ),
                ],
              ),
            ),

            ListTile(
              leading: const Icon(Icons.speed),
              title: const Text('Daily Metering'),
              selected: selectedIndex == 0,
              onTap: () {
                setState(() {
                  selectedIndex = 0;
                });

                Navigator.pop(context);
              },
            ),

            ListTile(
              leading: const Icon(Icons.solar_power),
              title: const Text('Inverter Readings'),
              selected: selectedIndex == 1,
              onTap: () {
                setState(() {
                  selectedIndex = 1;
                });

                Navigator.pop(context);
              },
            ),

            const Divider(),

            ListTile(
              leading: const Icon(Icons.logout),
              title: const Text('Logout'),
              onTap: () {
                Navigator.pushAndRemoveUntil(
                  context,
                  MaterialPageRoute(
                    builder: (_) => const LoginPage(),
                  ),
                  (_) => false,
                );
              },
            ),
          ],
        ),
      ),

      body: pages[selectedIndex],
    );
  }
}

// ============================================================
// DAILY METERING
// ============================================================

class DailyMeteringPage extends StatefulWidget {
  final String siteName;

  const DailyMeteringPage({
    super.key,
    required this.siteName,
  });

  @override
  State<DailyMeteringPage> createState() => _DailyMeteringPageState();
}

class _DailyMeteringPageState extends State<DailyMeteringPage> {
  final previousController = TextEditingController();
  final currentController = TextEditingController();

  double consumption = 0;

  void calculate() {
    final previous =
        double.tryParse(previousController.text) ?? 0;

    final current =
        double.tryParse(currentController.text) ?? 0;

    setState(() {
      consumption = current - previous;
    });
  }

  @override
  void dispose() {
    previousController.dispose();
    currentController.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(24),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          const Text(
            'Daily Metering',
            style: TextStyle(
              fontSize: 28,
              fontWeight: FontWeight.bold,
            ),
          ),

          const SizedBox(height: 8),

          Text(widget.siteName),

          const SizedBox(height: 30),

          TextField(
            controller: previousController,
            keyboardType: const TextInputType.numberWithOptions(
              decimal: true,
            ),
            decoration: const InputDecoration(
              labelText: 'Previous Meter Reading',
              suffixText: 'MWh',
              prefixIcon: Icon(Icons.history),
              border: OutlineInputBorder(),
            ),
          ),

          const SizedBox(height: 16),

          TextField(
            controller: currentController,
            keyboardType: const TextInputType.numberWithOptions(
              decimal: true,
            ),
            decoration: const InputDecoration(
              labelText: 'Current Meter Reading',
              suffixText: 'MWh',
              prefixIcon: Icon(Icons.speed),
              border: OutlineInputBorder(),
            ),
          ),

          const SizedBox(height: 24),

          SizedBox(
            width: double.infinity,
            height: 50,
            child: ElevatedButton(
              onPressed: calculate,
              child: const Text('CALCULATE'),
            ),
          ),

          const SizedBox(height: 30),

          Card(
            child: Padding(
              padding: const EdgeInsets.all(24),
              child: Column(
                children: [
                  const Text(
                    'Energy Consumed',
                    style: TextStyle(
                      fontSize: 18,
                    ),
                  ),

                  const SizedBox(height: 10),

                  Text(
                    '${consumption.toStringAsFixed(2)} MWh',
                    style: const TextStyle(
                      fontSize: 32,
                      fontWeight: FontWeight.bold,
                      color: Color(0xFF1565C0),
                    ),
                  ),
                ],
              ),
            ),
          ),
        ],
      ),
    );
  }
}

